{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "module": "Node16",
    "target": "ES2020",
    "lib": ["ES2020"],

    
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "Node16",
    "typeRoots": ["./node_modules/@types", "./src/types"]
  },
  "include": ["src"]
}